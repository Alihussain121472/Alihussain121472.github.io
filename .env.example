# ==============================================================================
# ARAKNET.TECH — ENVIRONMENT CONFIGURATION TEMPLATE
# Portfolio of Syed Ali Hussain · AI Engineer & Full Stack Developer
# ==============================================================================
#
# HOW TO USE
# ----------
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your real values in .env.local
# 3. .env.local is git-ignored — it NEVER gets committed or pushed
# 4. For Vercel: paste these values in Project Settings → Environment Variables
#
# IMPORTANT: This portfolio is a 100% static site (HTML + CSS + JS).
# The browser never reads these variables — they are documentation only
# and a reference for any future serverless function you may add.
# Do NOT inject these into client-side code or they will be publicly visible.
# ==============================================================================

# ── Owner identity ──────────────────────────────────────────────────────────
OWNER_NAME="Syed Ali Hussain"
OWNER_ROLE="AI Engineer & Full Stack Developer"
OWNER_EMAIL="syedali6160@gmail.com"
PORTFOLIO_URL="https://araknet.tech"

# ── Contact / email gateway ─────────────────────────────────────────────────
# The contact form currently uses a mailto: link (no server needed).
# If you ever migrate to a serverless form handler, set your endpoint here.
# Example services: FormSubmit, Web3Forms, Resend, EmailJS
CONTACT_FORM_ENDPOINT=""

# ── Vercel (auto-populated by Vercel, do not set manually) ──────────────────
# VERCEL_URL is injected automatically on every deployment.
# VERCEL_ENV is "production", "preview", or "development".
# VERCEL_GIT_COMMIT_SHA is the SHA of the deployed commit.
# These are listed here for reference only — Vercel sets them itself.
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
